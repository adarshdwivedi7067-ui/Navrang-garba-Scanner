<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Navrang Garba 2.0 - Staff Scanner</title>

  <script src="https://unpkg.com/html5-qrcode" type="text/javascript"></script>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      text-align: center;
      padding: 20px;
    }

    .box {
      max-width: 500px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }

    h1 {
      margin-bottom: 5px;
    }

    #reader {
      margin-top: 20px;
    }

    #result {
      margin-top: 20px;
      padding: 20px;
      border-radius: 12px;
      font-size: 20px;
      font-weight: bold;
    }

    .waiting {
      background: #eeeeee;
    }

    .success {
      background: #d4edda;
      color: #155724;
    }

    .error {
      background: #f8d7da;
      color: #721c24;
    }
  </style>
</head>

<body>

<div class="box">

  <h1>🎉 NAVRANG GARBA 2.0</h1>
  <h3>STAFF ENTRY SCANNER</h3>

  <div id="reader"></div>

  <div id="result" class="waiting">
    📷 QR scan karo
  </div>

</div>

<script>

function onScanSuccess(decodedText) {

  document.getElementById("result").className = "success";

  document.getElementById("result").innerHTML =
    "✅ QR SCANNED<br><br>" +
    "PASS ID:<br>" +
    decodedText;

  // Scanner temporarily stop after successful scan
  html5QrcodeScanner.clear().catch(function(error) {
    console.log(error);
  });
}

function onScanFailure(error) {
  // Normal scanning failures are ignored
}

const html5QrcodeScanner = new Html5QrcodeScanner(
  "reader",
  {
    fps: 10,
    qrbox: {
      width: 250,
      height: 250
    }
  },
  false
);

html5QrcodeScanner.render(onScanSuccess, onScanFailure);

</script>

</body>
</html>
